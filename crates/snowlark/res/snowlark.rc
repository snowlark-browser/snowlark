// The application icon: Explorer shows the first icon of the executable, and the window class loads
// this id (snowlark-paint's window.rs). Made by tools/icon/make_icon.py.
1 ICON "snowlark.ico"

// The version resource: Explorer's Details tab, the taskbar and Task Manager show its product name and
// description. build.rs defines VER_MAJOR, VER_MINOR, VER_PATCH and VER_STRING from the package version.
#include <winver.h>
#define STR_(x) #x
#define STR(x) STR_(x)

VS_VERSION_INFO VERSIONINFO
FILEVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
PRODUCTVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Snowlark"
            VALUE "FileDescription", "Snowlark"
            VALUE "FileVersion", STR(VER_STRING)
            VALUE "ProductName", "Snowlark"
            VALUE "ProductVersion", STR(VER_STRING)
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
