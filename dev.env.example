# Local settings for dev.ps1 and the tools. Copy to `dev.env` (git-ignored) and uncomment what you need;
# CONTRIBUTING.md describes each setting. An environment variable of the same name wins.

# A folder on an SSD for the crate cache, build output of checkouts on other drives, a local V8 library, and the
# tools' scratch files and results.
#SNOWLARK_DEV_DIR=D:\snowlark-dev

# Queue builds, test runs and WPT runs on machine-wide slots (several checkouts building at once).
#SNOWLARK_SLOTS=1

# The web-platform-tests checkout (default: a folder `wpt` next to the repository), and where results and
# baselines are kept (default: <dev dir>\wpt).
#SNOWLARK_WPT=D:\wpt
#SNOWLARK_WPT_STATE=D:\snowlark-dev\wpt

# A local copy of Speedometer 3.1 (default: <dev dir>\speedometer-3.1).
#SNOWLARK_SPEEDOMETER=D:\snowlark-dev\speedometer-3.1

# Where the tools that drive a real window open it, as x,y (default 100,100): a monitor you are not working on.
#SNOWLARK_TEST_WINDOW_POS=2000,100

# A folder with rusty_v8.lib and src_binding.rs to link instead of downloading the pinned library
# (docs/v8-build.md).
#SNOWLARK_V8_DIR=D:\snowlark-dev\v8\158.0.0-ptrcomp-pgo1-lto2b-bpgo2-pub
