{
 "about": "Spec areas and features for tools/payoff/rank.py. Each area: id, title, size (S, M, L: a few days of work, a week or two, longer), spec (where to read), wpt (directory prefixes; a leading ! leaves a directory out), match (regular expressions over signal keys: 'api: <member>', 'ecmascript: <member>', 'css: <sweep supports group>', 'layout: <sweep layout group>', 'scroll: ...', 'exception: <message>'). A signal belongs to the first area that matches it. weights override rank.py's DEFAULT_WEIGHTS.",
 "weights": {},
 "ignore_about": "Signals not counted: members no standard asks for (one engine's experiments and private APIs), members specs removed, and CSS with no effect on a screen (speech, printing, installed-app window regions).",
 "ignore": [
  "browsingTopics",
  "featurePolicy",
  "FeaturePolicy",
  "^api: (Summarizer|Translator|LanguageModel|LanguageDetector|Writer|Rewriter|Proofreader)\\b",
  "^api: window\\.(TEMPORARY|PERSISTENT|webkit)",
  "^api: DOMError\\b",
  "lastModifiedDate",
  "zoomAndPan",
  "PerformanceSoftNavigation|SoftNavigation",
  "TimelineTrigger",
  "^api: .*\\b(chrome|Chrome)\\b",
  "^api: .*(AttributionReporting|attributionSrc|SharedStorage|sharedStorage|Fence|fence|joinAdInterestGroup|runAdAuction|InterestGroup|privateToken|PrivateToken)",
  "^css: (prop:speak|prop:(-webkit-)?app-region|prop:(-webkit-)?print-color-adjust|rule:page|prop:size)$"
 ],
 "areas": [
  {
   "id": "scrollbars",
   "title": "Custom scroll bars (::-webkit-scrollbar, scrollbar-color, scrollbar-width, scrollbar-gutter)",
   "size": "M",
   "spec": "CSS Scrollbars Styling 1; CSS Overflow 3 (scrollbar-gutter)",
   "wpt": [
    "css/css-scrollbars/"
   ],
   "match": [
    "^css: .*scrollbar",
    "^layout: .*scrollbar"
   ]
  },
  {
   "id": "view-transitions",
   "title": "View Transitions",
   "size": "L",
   "spec": "CSS View Transitions 1 and 2",
   "wpt": [
    "css/css-view-transitions/"
   ],
   "match": [
    "^css: .*view-transition",
    "^api: .*(ViewTransition|startViewTransition|activeViewTransition)"
   ]
  },
  {
   "id": "filter-effects",
   "title": "Filter effects (filter, backdrop-filter, canvas filter)",
   "size": "L",
   "spec": "Filter Effects 1 and 2; HTML canvas 'Filters'",
   "wpt": [
    "css/filter-effects/"
   ],
   "match": [
    "^css: .*(prop|kw):(-webkit-)?(backdrop-)?filter\\b",
    "^css: fn:(blur|drop-shadow|grayscale|sepia|saturate|hue-rotate|invert|brightness|contrast)\\(",
    "^layout: value: (backdrop-)?filter$"
   ]
  },
  {
   "id": "masking",
   "title": "Masking and clipping (mask, -webkit-mask, clip-path)",
   "size": "M",
   "spec": "CSS Masking 1",
   "wpt": [
    "css/css-masking/"
   ],
   "match": [
    "^css: .*(mask|clip-path)",
    "^layout: value: (clip-path|mask.*)$"
   ]
  },
  {
   "id": "multicol",
   "title": "Multi-column layout",
   "size": "L",
   "spec": "CSS Multi-column Layout 1",
   "wpt": [
    "css/css-multicol/"
   ],
   "match": [
    "^css: .*(column-(count|width|span|fill|rule|gap|break)|columns\\b|break-(inside|before|after))",
    "^layout: .*multicol"
   ]
  },
  {
