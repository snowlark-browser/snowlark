{
  "notes": [
    "Which WPT directories a change to a path can alter: `python tools/wpt/affected.py` reads this, `run.py --gate --affected` gates only those.",
    "A file matches the rule with the longest path prefix; a file that matches none gates everything (@all and @v8). `ignore` patterns (fnmatch on the repository path) are files no page observes.",
    "@all: every directory but `v8_only`. @v8: the `v8_only` directories, which only the JavaScript engine can change. @<name>: a group below. Anything else is a directory of the WPT checkout.",
    "A rule without @all says pages observe that crate only through the directories it names. That includes what depends on it: `used_by` lists the crates that depend on it today, and tools/wpt/test_affected.py fails when the dependency graph differs, so a new dependent is looked at before the rule is trusted.",
    "A full gate (no --affected) is the backstop: it also catches a restricted rule that is wrong."
  ],
  "v8_only": ["wasm", "third_party"],
  "groups": {
    "net": ["fetch", "xhr", "cors", "cookies", "cookiestore", "content-security-policy", "referrer-policy", "mixed-content",
            "upgrade-insecure-requests", "websockets", "eventsource", "service-workers", "subresource-integrity", "mimesniff",
            "preload", "resource-timing", "server-timing", "x-frame-options", "beacon", "https-upgrades", "hsts",
            "network-error-logging", "reporting", "clear-site-data", "nav-tracking-mitigations", "secure-contexts", "loading",
            "compression", "import-maps", "private-click-measurement", "connection-allowlist", "client-hints", "ua-client-hints",
            "speculation-rules", "storage-access-api", "background-fetch", "webtransport", "content-dpr", "document-policy",
            "permissions-policy", "html/cross-origin-embedder-policy", "html/cross-origin-opener-policy",
            "html/anonymous-iframe", "html/document-isolation-policy"],
    "documents": ["html/browsers", "html/semantics", "html/webappapis", "html/dom", "workers", "webmessaging", "FileAPI", "streams",
                  "svg", "css/css-fonts", "css/css-images", "css/css-backgrounds", "css/css-masking", "css/css-ui",
                  "css/css-font-loading", "fonts", "navigation-api", "navigation-timing", "paint-timing", "url"],
    "media": ["media", "media-source", "mediacapture-streams", "mediacapture-record", "mediacapture-image", "mediacapture-fromelement",
              "mediacapture-insertable-streams", "mediacapture-handle", "mediacapture-region", "mediacapture-extensions", "webcodecs",
              "mediasession", "media-capabilities", "media-playback-quality", "encrypted-media", "picture-in-picture",
              "remote-playback", "audio-output", "audio-session", "autoplay-policy-detection", "webrtc", "webrtc-stats",
              "webrtc-encoded-transform", "webrtc-extensions", "webrtc-ice", "webvtt", "screen-capture", "html-media-capture",
              "webaudio", "html/semantics/embedded-content", "html/rendering/replaced-elements"],
    "gl": ["webgl", "webgpu", "html/canvas", "imagebitmap-renderingcontext", "offscreen-canvas"],
    "storage": ["IndexedDB", "storage", "fs", "file-system-access", "webstorage", "web-locks"],
    "text": ["css", "svg", "mathml", "fonts", "font-access", "html/canvas", "html/rendering", "html/semantics/forms",
             "html/semantics/embedded-content", "editing", "selection", "contenteditable", "pointerevents"]
  },
  "ignore": [
    "*.md", "docs/*", "reviews/*", "bench/*", "benchmarks/*", ".github/*", "LICENSE*", "dev.env.example", "THIRD-PARTY*",
    "crates/*/tests/*", "crates/*/benches/*", "crates/*/fuzz/*",
    "tools/wpt/test_*.py", "tools/wpt/README.md", "tools/wpt/REFTESTS.md", "tools/wpt/flaky.json", "tools/wpt/parity.py",
    "tools/wpt/triage.py", "tools/wpt/compare.py", "tools/test-workspace*", "tools/speedometer/*", "tools/micro-bench/*",
    "tools/vs-chrome/*", "tools/scroll-ab/*", "tools/layout-diff/*", "tools/census/*", "tools/sweep/*", "tools/payoff/*",
    "tools/release/*", "tools/credits/*", "tools/frame-trace/*", "tools/heap-retainers/*", "tools/proc-proto/*",
    "tools/scrub/*", "tools/icon/*", "tools/angle/*", "tools/license_headers.py", "tools/devenv*"
  ],
  "rules": [
    {"path": "crates/snowlark-shell/", "gate": [], "used_by": ["snowlark"]},
    {"path": "crates/snowlark-blocker/", "gate": ["@net", "@documents"], "used_by": ["snowlark", "snowlark-shell"]},
    {"path": "crates/snowlark-net/", "gate": ["@net", "@documents", "@media"],
     "used_by": ["snowlark", "snowlark-blocker", "snowlark-media", "snowlark-page", "snowlark-render", "snowlark-shell", "snowlark-tab"]},
    {"path": "crates/snowlark-media/", "gate": ["@media", "@documents"], "used_by": ["snowlark", "snowlark-page", "snowlark-shell", "snowlark-tab"]},
    {"path": "crates/snowlark-audio/", "gate": ["@media"], "used_by": ["snowlark-media", "snowlark-page", "snowlark-tab"]},
    {"path": "crates/snowlark-gl/", "gate": ["@gl"], "used_by": ["snowlark-page"]},
    {"path": "crates/snowlark-idb/", "gate": ["@storage"], "used_by": ["snowlark", "snowlark-page", "snowlark-shell", "snowlark-tab"]},
    {"path": "crates/snowlark-ots-sys/", "gate": ["@text"], "used_by": ["snowlark-paint"]},
    {"path": "crates/snowlark-js/", "gate": ["@all", "@v8"]},
    {"path": "crates/snowlark-bindings/", "gate": ["@all"]},
    {"path": "crates/snowlark-idl/", "gate": ["@all"]},
    {"path": "crates/snowlark-dom/", "gate": ["@all"]},
    {"path": "crates/snowlark-style/", "gate": ["@all"]},
    {"path": "crates/snowlark-layout/", "gate": ["@all"]},
    {"path": "crates/snowlark-paint/", "gate": ["@all"]},
    {"path": "crates/snowlark-render/", "gate": ["@all"]},
    {"path": "crates/snowlark-page/", "gate": ["@all"]},
    {"path": "crates/snowlark-tab/", "gate": ["@all"]},
    {"path": "crates/snowlark-ipc/", "gate": ["@all"]},
    {"path": "crates/snowlark/", "gate": ["@all"]},
    {"path": "crates/snowlark/src/cli/bench.rs", "gate": []},
    {"path": "crates/snowlark/src/cli/speedometer.rs", "gate": []},
    {"path": "crates/snowlark/src/cli/layout_demo.rs", "gate": []},
    {"path": "crates/snowlark/src/cli/render_demo.rs", "gate": []},
    {"path": "crates/snowlark/src/cli/computed.rs", "gate": []},
    {"path": "crates/snowlark/src/cli/media_types.rs", "gate": []},
    {"path": "idl/", "gate": ["@all"]},
    {"path": "vendor/stylo/", "gate": ["@all"]},
    {"path": "vendor/taffy/", "gate": ["@all"]},
    {"path": "vendor/html5ever/", "gate": ["@all"]},
    {"path": "vendor/url/", "gate": ["@all"]},
    {"path": "vendor/v8/", "gate": ["@all", "@v8"]},
    {"path": "vendor/ots/", "gate": ["@text"]},
    {"path": "vendor/woff2/", "gate": ["@text"]},
    {"path": "tools/v8-pgo/", "gate": ["@all", "@v8"]},
    {"path": "tools/wpt/", "gate": ["@all", "@v8"]},
    {"path": "Cargo.toml", "gate": ["@all", "@v8"]},
    {"path": "Cargo.lock", "gate": ["@all", "@v8"]},
    {"path": "rust-toolchain", "gate": ["@all", "@v8"]},
    {"path": ".cargo/", "gate": ["@all", "@v8"]},
    {"path": "dev.ps1", "gate": ["@all", "@v8"]}
  ]
}
